{
  "model": "gpt-6.1-sol",
  "embedding_model": "text-embedding-3-small",
  "chunk_size": 1000,
  "chunk_overlap": 200,
  "top_k": 7,
  "fetch_k": 24,
  "search_mode": "similarity",
  "mmr_lambda": 0.65,
  "candidate_count": 12,
  "selected_count": 3,
  "timeout": 30,
  "retries": 2,
  "request_interval": 1.2,
  "cache_hours": 168,
  "failure_cache_minutes": 10,
  "history_turns": 6,
  "allow_body_storage": true,
  "allow_llm_transfer": true,
  "enable_web_context": true,
  "web_result_count": 3,
  "web_request_interval": 6.1,
  "primary_retry_queries": 2,
  "enable_encyclopedia": true
}
